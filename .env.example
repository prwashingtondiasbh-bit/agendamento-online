# ============================================================================
# 1. BANCO DE DADOS MYSQL (HOSTINGER)
# ============================================================================
# Substitua pelos dados reais do banco MySQL criado no hPanel da Hostinger.
# Nunca comite o arquivo .env real no Git.
DATABASE_URL="mysql://username:password@hostname:3306/database_name"

# Modo estrito de persistência MySQL (Obrigatório "true" em produção na Hostinger)
# Quando "true", impede fallback silencioso para memória e retorna HTTP 503 se o MySQL estiver indisponível
DB_STRICT_MODE="true"

# ============================================================================
# 2. CONFIGURAÇÃO DO SERVIDOR E AMBIENTE
# ============================================================================
PORT=3000
NODE_ENV="production"
DEFAULT_TIMEZONE="America/Sao_Paulo"
CURRENCY="BRL"
APP_BASE_URL="http://localhost:3000"
API_BASE_URL="http://localhost:3000/api/v1"
# Lista opcional de origens permitidas em produção (separadas por vírgula)
CORS_ALLOWED_ORIGINS="http://localhost:3000"

# ============================================================================
# 3. AUTENTICAÇÃO E SESSÃO
# ============================================================================
SESSION_SECRET="substitua_por_uma_chave_secreta_aleatoria_com_32_caracteres"

# ============================================================================
# 4. INTEGRAÇÃO MERCADO PAGO (PIX E REEMBOLSOS)
# ============================================================================
# Obtenha as credenciais no painel de desenvolvedores do Mercado Pago
MP_ACCESS_TOKEN="TEST-0000000000000000-000000-00000000000000000000000000000000-000000000"
MP_WEBHOOK_SECRET="seu_webhook_secret_aqui"
MP_ENVIRONMENT="sandbox"

# ============================================================================
# 5. INTEGRAÇÃO OFICIAL WHATSAPP BUSINESS (META CLOUD API - ETAPA 10)
# ============================================================================
WHATSAPP_API_VERSION="v20.0"
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""
WHATSAPP_APP_SECRET=""
WHATSAPP_CONFIG_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# ============================================================================
# 6. PROTEÇÃO ANTI-BOT (CLOUDFLARE TURNSTILE)
# ============================================================================
VITE_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

