generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum TenantStatus {
  ACTIVE
  BLOCKED
  CANCELLED
}

model Tenant {
  id                              String                      @id @default(uuid()) @db.VarChar(36)
  name                            String                      @db.VarChar(150)
  slug                            String                      @unique(map: "slug") @db.VarChar(100)
  description                     String?                     @db.Text
  logoUrl                         String?                     @db.VarChar(500)
  phone                           String?                     @db.VarChar(30)
  email                           String?                     @db.VarChar(150)
  address                         String?                     @db.VarChar(255)
  timezone                        String                      @default("America/Sao_Paulo") @db.VarChar(100)
  currency                        String                      @default("BRL") @db.VarChar(10)
  openTime                        String                      @default("09:00") @db.VarChar(10)
  closeTime                       String                      @default("19:00") @db.VarChar(10)
  status                          TenantStatus                @default(ACTIVE)
  isPublished                     Boolean                     @default(true)
  blockedReason                   String?                     @db.Text
  blockedAt                       DateTime?
  blockedBy                       String?                     @db.VarChar(36)
  cancelledAt                     DateTime?
  cancelledReason                 String?                     @db.Text
  requireDeposit                  Boolean                     @default(true)
  defaultDeposit                  Int                         @default(30)
  cancellationHoursLimit          Int                         @default(6)
  allowCustomerReschedule         Boolean                     @default(true)
  allowManualReviewOutOfPeriod    Boolean                     @default(true)
  cancellationPolicyText          String?                     @db.Text
  cancellationContactInstructions String?                     @db.Text
  cancellationPolicyVersion       Int                         @default(1)
  createdAt                       DateTime                    @default(now())
  updatedAt                       DateTime                    @updatedAt
  members                         TenantMember[]
  subscriptions                   Subscription[]
  saasInvoices                    SaaSInvoice[]
  auditLogs                       AuditLog[]
  professionals                   Professional[]
  clients                         Client[]
  services                        Service[]
  appointments                    Appointment[]
  payments                        Payment[]
  webhookEvents                   WebhookEvent[]
  timeBlocks                      TimeBlock[]
  cancellationRequests            CancellationRequest[]
  refundRequests                  RefundRequest[]
  expenses                        Expense[]
  financialTransactions           FinancialTransaction[]
  commissionRules                 CommissionRule[]
  commissionRecords               CommissionRecord[]
  whatsappConfig                  WhatsAppConfig?
  whatsappTemplates               WhatsAppTemplate[]
  whatsappMessages                WhatsAppMessageQueue[]
  whatsappReminders               WhatsAppScheduledReminder[]
  whatsappWebhookEvents           WhatsAppWebhookEvent[]
  businessLocations               BusinessLocation[]
  waitlistEntries                 WaitlistEntry[]
  waitlistOffers                  WaitlistOffer[]
  loyaltyProgram                  LoyaltyProgram?
  loyaltyRewards                  LoyaltyReward[]
  loyaltyLedgers                  LoyaltyLedger[]
  coupons                         Coupon[]
  couponRedemptions               CouponRedemption[]
  servicePackages                 ServicePackage[]
  customerPackages                CustomerPackage[]
  packageUsageLedgers             PackageUsageLedger[]
  giftCards                       GiftCard[]
  giftCardTransactions            GiftCardTransaction[]
  serviceReviews                  ServiceReview[]
  marketingCampaigns              MarketingCampaign[]
  campaignRecipients              CampaignRecipient[]
  inventoryProducts               InventoryProduct[]
  inventoryMovements              InventoryMovement[]

  @@index([status, isPublished], map: "Tenant_status_isPublished_idx")
}

model User {
  id            String         @id @default(uuid()) @db.VarChar(36)
  name          String         @db.VarChar(150)
  email         String         @unique(map: "email") @db.VarChar(150)
  phone         String?        @db.VarChar(30)
  passwordHash  String         @db.VarChar(255)
  resetToken    String?        @db.VarChar(255)
  resetExpires  DateTime?
  isMasterAdmin Boolean        @default(false)
  active        Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  memberships   TenantMember[]
  clients       Client[]
  auditLogs     AuditLog[]
}

enum Role {
  SUPER_ADMIN
  OWNER
  MANAGER
  RECEPTIONIST
  PROFESSIONAL
  CUSTOMER
}

model TenantMember {
  id          String   @id @default(uuid()) @db.VarChar(36)
  tenantId    String   @db.VarChar(36)
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  userId      String   @db.VarChar(36)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  role        Role     @default(PROFESSIONAL)
  permissions Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, userId], map: "unique_tenant_user")
  @@index([userId], map: "userId")
}

enum Plan {
  SIMPLE
  COMPLETE
  FREE
  PRO
  ENTERPRISE
}

enum SubStatus {
  ACTIVE
  PENDING_PAYMENT
  PAST_DUE
  SUSPENDED
  BLOCKED
  CANCELLED
}

model Subscription {
  id                   String        @id @default(uuid()) @db.VarChar(36)
  tenantId             String        @db.VarChar(36)
  tenant               Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  plan                 Plan          @default(COMPLETE)
  status               SubStatus     @default(ACTIVE)
  contractedPriceCents Int           @default(9990)
  billingCycle         String        @default("MONTHLY") @db.VarChar(20)
  startedAt            DateTime      @default(now())
  expiresAt            DateTime?
  nextBillingAt        DateTime?
  cancelledAt          DateTime?
  statusReason         String?       @db.Text
  updatedBy            String?       @db.VarChar(36)
  externalProviderRef  String?       @db.VarChar(191)
  history              Json?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  invoices             SaaSInvoice[]

  @@index([tenantId], map: "tenantId")
  @@index([status, nextBillingAt], map: "Subscription_status_nextBillingAt_idx")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.VarChar(36)
  tenantId  String?  @db.VarChar(36)
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull, onUpdate: Restrict)
  userId    String?  @db.VarChar(36)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: Restrict)
  action    String   @db.VarChar(150)
  details   Json?
  ipAddress String?  @db.VarChar(50)
  createdAt DateTime @default(now())

  @@index([tenantId], map: "tenantId")
  @@index([userId], map: "userId")
}

model Professional {
  id           String                @id @default(uuid()) @db.VarChar(36)
  tenantId     String                @db.VarChar(36)
  tenant       Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  name         String                @db.VarChar(150)
  email        String?               @db.VarChar(150)
  phone        String?               @db.VarChar(30)
  avatarUrl    String?               @db.VarChar(500)
  specialty    String?               @default("Nail Designer Geral") @db.VarChar(150)
  active       Boolean               @default(true)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  services     ServiceProfessional[]
  workingHours WorkingHour[]
  timeBlocks   TimeBlock[]
  appointments Appointment[]

  @@index([tenantId], map: "tenantId")
}

model Service {
  id              String                @id @default(uuid()) @db.VarChar(36)
  tenantId        String                @db.VarChar(36)
  tenant          Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  name            String                @db.VarChar(150)
  description     String?               @db.Text
  durationMin     Int                   @default(60)
  price           Decimal               @default(0.00) @db.Decimal(10, 2)
  category        String?               @default("Unhas") @db.VarChar(100)
  active          Boolean               @default(true)
  priceCents      Int                   @default(0)
  bufferBeforeMin Int                   @default(0)
  bufferAfterMin  Int                   @default(0)
  preparationMin  Int                   @default(0)
  depositPercent  Int                   @default(30)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  professionals   ServiceProfessional[]
  appointments    Appointment[]

  @@index([tenantId], map: "tenantId")
}

model ServiceProfessional {
  id             String       @id @default(uuid()) @db.VarChar(36)
  serviceId      String       @db.VarChar(36)
  service        Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  professionalId String       @db.VarChar(36)
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@unique([serviceId, professionalId], map: "unique_service_prof")
  @@index([professionalId], map: "professionalId")
}

model WorkingHour {
  id             String       @id @default(uuid()) @db.VarChar(36)
  professionalId String       @db.VarChar(36)
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  dayOfWeek      Int
  startTime      String       @default("09:00") @db.VarChar(10)
  endTime        String       @default("19:00") @db.VarChar(10)
  breakStart     String?      @db.VarChar(10)
  breakEnd       String?      @db.VarChar(10)

  @@index([professionalId], map: "professionalId")
}

model TimeBlock {
  id             String        @id @default(uuid()) @db.VarChar(36)
  tenantId       String        @db.VarChar(36)
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  professionalId String?       @db.VarChar(36)
  professional   Professional? @relation(fields: [professionalId], references: [id], onDelete: SetNull, onUpdate: Restrict)
  type           BlockType     @default(DAY_OFF)
  startDate      DateTime
  endDate        DateTime
  reason         String?       @db.VarChar(255)
  createdBy      String?       @db.VarChar(36)
  createdAt      DateTime      @default(now())

  @@index([tenantId], map: "tenantId")
  @@index([professionalId], map: "professionalId")
}

enum BlockType {
  DAY_OFF
  VACATION
  BREAK
  INTERVAL
  LUNCH
  PERSONAL
  EXCEPTION
}

model Appointment {
  id                        String                @id @default(uuid()) @db.VarChar(36)
  tenantId                  String                @db.VarChar(36)
  tenant                    Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  clientId                  String                @db.VarChar(36)
  client                    Client                @relation(fields: [clientId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  professionalId            String                @db.VarChar(36)
  professional              Professional          @relation(fields: [professionalId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  serviceId                 String                @db.VarChar(36)
  service                   Service               @relation(fields: [serviceId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  dateTime                  DateTime
  endDateTime               DateTime?
  status                    AppointmentStatus     @default(PENDING_PAYMENT)
  origin                    String                @default("ONLINE") @db.VarChar(50)
  expiresAt                 DateTime?
  totalAmount               Decimal               @default(0.00) @db.Decimal(10, 2)
  totalAmountCents          Int                   @default(0)
  depositAmountCents        Int                   @default(0)
  balanceAmountCents        Int                   @default(0)
  snapshotPriceCents        Int                   @default(0)
  snapshotDurationMin       Int                   @default(60)
  snapshotDepositPercent    Int                   @default(30)
  snapshotDepositCents      Int                   @default(0)
  snapshotBalanceCents      Int                   @default(0)
  snapshotCancellationHours Int?
  snapshotPolicyText        String?               @db.Text
  snapshotPolicyVersion     Int?
  policyAcceptedAt          DateTime?
  rescheduledFromDateTime   DateTime?
  rescheduledAt             DateTime?
  rescheduleCount           Int                   @default(0)
  rescheduleHistory         Json?
  createdBy                 String?               @db.VarChar(36)
  updatedBy                 String?               @db.VarChar(36)
  startedAt                 DateTime?
  completedAt               DateTime?
  noShowAt                  DateTime?
  locationId                String?               @db.VarChar(36)
  couponCode                String?               @db.VarChar(100)
  discountCents             Int                   @default(0)
  notes                     String?               @db.Text
  createdAt                 DateTime              @default(now())
  updatedAt                 DateTime              @updatedAt
  payments                  Payment[]
  cancellationRequests      CancellationRequest[]
  refundRequests            RefundRequest[]

  @@index([tenantId], map: "tenantId")
  @@index([clientId], map: "clientId")
  @@index([professionalId], map: "professionalId")
  @@index([serviceId], map: "serviceId")
  @@index([professionalId, dateTime, endDateTime], map: "idx_appointment_prof_datetime")
  @@index([tenantId, dateTime], map: "idx_appointment_tenant_datetime")
}

model Client {
  id                          String                @id @default(uuid()) @db.VarChar(36)
  tenantId                    String                @db.VarChar(36)
  tenant                      Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  userId                      String?               @db.VarChar(36)
  user                        User?                 @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: Restrict)
  name                        String                @db.VarChar(150)
  phone                       String                @db.VarChar(30)
  email                       String?               @db.VarChar(150)
  notes                       String?               @db.Text
  preferences                 String?               @db.Text
  internalNotes               Json?
  tags                        Json?
  communicationConsent        Json?
  normalizedPhone             String?               @db.VarChar(32)
  whatsappOptIn               Boolean               @default(true)
  promotionalConsent          Boolean               @default(false)
  promotionalConsentAt        DateTime?
  promotionalConsentSource    String?               @db.VarChar(100)
  promotionalConsentRevokedAt DateTime?
  active                      Boolean               @default(true)
  createdAt                   DateTime              @default(now())
  updatedAt                   DateTime              @updatedAt
  appointments                Appointment[]
  cancellationRequests        CancellationRequest[]
  refundRequests              RefundRequest[]

  @@index([tenantId], map: "tenantId")
  @@index([userId], map: "Client_userId_idx")
  @@index([tenantId, userId], map: "Client_tenantId_userId_idx")
  @@index([tenantId, phone], map: "Client_tenantId_phone_idx")
  @@index([tenantId, normalizedPhone], map: "Client_tenantId_normalizedPhone_idx")
}

enum AppointmentStatus {
  PENDING_PAYMENT
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  EXPIRED
  NO_SHOW
}

enum PaymentStatus {
  CREATED
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  EXPIRED
  REFUND_PENDING
  REFUNDED
}

model Payment {
  id                   String          @id @default(uuid()) @db.VarChar(36)
  tenantId             String          @db.VarChar(36)
  tenant               Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  appointmentId        String          @db.VarChar(36)
  appointment          Appointment     @relation(fields: [appointmentId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  provider             String          @default("MERCADO_PAGO") @db.VarChar(50)
  providerPaymentId    String?         @db.VarChar(100)
  externalReference    String          @unique(map: "externalReference") @db.VarChar(150)
  idempotencyKey       String          @unique(map: "idempotencyKey") @db.VarChar(150)
  paymentType          String          @default("DEPOSIT") @db.VarChar(50)
  amountCents          Int
  feeCents             Int?
  netAmountCents       Int?
  refundedAmountCents  Int             @default(0)
  currency             String          @default("BRL") @db.VarChar(10)
  status               PaymentStatus   @default(CREATED)
  paymentMethod        String          @default("PIX") @db.VarChar(50)
  reconciliationStatus String          @default("RECONCILED") @db.VarChar(60)
  qrCode               String?         @db.Text
  qrCodeBase64         String?         @db.LongText
  ticketUrl            String?         @db.VarChar(500)
  expiresAt            DateTime?
  approvedAt           DateTime?
  rawResponse          Json?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  refundRequests       RefundRequest[]

  @@index([appointmentId], map: "idx_payment_appointment")
  @@index([providerPaymentId], map: "idx_payment_provider_id")
  @@index([tenantId, status], map: "idx_payment_tenant_status")
}

enum WebhookProcessingStatus {
  PENDING
  PROCESSED
  FAILED
  IGNORED
}

model WebhookEvent {
  id               String                  @id @default(uuid()) @db.VarChar(36)
  tenantId         String?                 @db.VarChar(36)
  tenant           Tenant?                 @relation(fields: [tenantId], references: [id], onDelete: SetNull, onUpdate: Restrict)
  provider         String                  @default("MERCADO_PAGO") @db.VarChar(50)
  providerEventId  String?                 @db.VarChar(150)
  resourceId       String?                 @db.VarChar(150)
  eventType        String                  @db.VarChar(100)
  payload          Json?
  processingStatus WebhookProcessingStatus @default(PENDING)
  attempts         Int                     @default(1)
  receivedAt       DateTime                @default(now())
  processedAt      DateTime?
  lastError        String?                 @db.Text

  @@unique([provider, providerEventId], map: "unique_provider_event")
  @@index([tenantId], map: "tenantId")
}

enum CancellationRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  COMPLETED
}

enum RefundRequestStatus {
  NOT_REQUESTED
  PENDING_REVIEW
  APPROVED
  PROCESSING
  COMPLETED
  FAILED
  REJECTED
}

model CancellationRequest {
  id                        String                    @id @default(uuid()) @db.VarChar(36)
  referenceCode             String                    @unique @db.VarChar(100)
  tenantId                  String                    @db.VarChar(36)
  tenant                    Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  appointmentId             String                    @db.VarChar(36)
  appointment               Appointment               @relation(fields: [appointmentId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  clientId                  String                    @db.VarChar(36)
  client                    Client                    @relation(fields: [clientId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  status                    CancellationRequestStatus @default(PENDING)
  refundStatus              RefundRequestStatus       @default(NOT_REQUESTED)
  reason                    String?                   @db.Text
  isWithinPolicy            Boolean                   @default(false)
  isEligibleForRefund       Boolean                   @default(false)
  hoursNoticeCalculated     Float
  snapshotCancellationHours Int?
  snapshotPolicyText        String?                   @db.Text
  snapshotPolicyVersion     Int?
  deadlineCalculatedAt      DateTime
  paidDepositCents          Int                       @default(0)
  refundableAmountCents     Int                       @default(0)
  adminDecisionBy           String?                   @db.VarChar(36)
  adminDecisionAt           DateTime?
  adminJustification        String?                   @db.Text
  isManualException         Boolean                   @default(false)
  history                   Json?
  createdAt                 DateTime                  @default(now())
  updatedAt                 DateTime                  @updatedAt
  refundRequests            RefundRequest[]

  @@index([tenantId, status])
  @@index([appointmentId])
  @@index([clientId])
}

model RefundRequest {
  id                    String              @id @default(uuid()) @db.VarChar(36)
  tenantId              String              @db.VarChar(36)
  tenant                Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  cancellationRequestId String              @db.VarChar(36)
  cancellationRequest   CancellationRequest @relation(fields: [cancellationRequestId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  appointmentId         String              @db.VarChar(36)
  appointment           Appointment         @relation(fields: [appointmentId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  clientId              String              @db.VarChar(36)
  client                    Client              @relation(fields: [clientId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  paymentId             String?             @db.VarChar(36)
  payment               Payment?            @relation(fields: [paymentId], references: [id], onDelete: SetNull, onUpdate: Restrict)
  provider              String              @default("MERCADO_PAGO") @db.VarChar(50)
  providerPaymentId     String?             @db.VarChar(100)
  providerRefundId      String?             @db.VarChar(100)
  idempotencyKey        String              @unique @db.VarChar(150)
  amountCents           Int
  status                RefundRequestStatus @default(PENDING_REVIEW)
  authorizedBy          String?             @db.VarChar(36)
  authorizedAt          DateTime?
  processedAt           DateTime?
  completedAt           DateTime?
  lastError             String?             @db.Text
  rawResponse           Json?
  history               Json?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([tenantId, status])
  @@index([cancellationRequestId])
  @@index([appointmentId])
  @@index([paymentId])
}

enum ExpenseStatus {
  PENDING
  PAID
  CANCELLED
  REVERSED
}

model Expense {
  id                 String        @id @default(uuid()) @db.VarChar(36)
  tenantId           String        @db.VarChar(36)
  tenant             Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  description        String        @db.VarChar(255)
  category           String        @default("OUTRAS") @db.VarChar(100)
  amountCents        Int
  competenceDate     DateTime
  dueDate            DateTime
  paidAt             DateTime?
  status             ExpenseStatus @default(PENDING)
  paymentMethod      String?       @db.VarChar(60)
  notes              String?       @db.Text
  createdBy          String?       @db.VarChar(36)
  paidBy             String?       @db.VarChar(36)
  cancelledBy        String?       @db.VarChar(36)
  cancellationReason String?       @db.Text
  history            Json?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([tenantId, status])
  @@index([tenantId, dueDate])
  @@index([tenantId, competenceDate])
}

enum LedgerTransactionType {
  INFLOW
  OUTFLOW
  ADJUSTMENT
  REVERSAL
}

enum LedgerTransactionStatus {
  CONFIRMED
  REVERSED
  FLAGGED_FOR_REVIEW
}

model FinancialTransaction {
  id                        String                  @id @default(uuid()) @db.VarChar(36)
  tenantId                  String                  @db.VarChar(36)
  tenant                    Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  uniqueRef                 String                  @db.VarChar(150)
  type                      LedgerTransactionType
  origin                    String                  @db.VarChar(100)
  originId                  String?                 @db.VarChar(36)
  amountCents               Int
  feeCents                  Int?
  netAmountCents            Int
  category                  String                  @db.VarChar(100)
  description               String                  @db.VarChar(255)
  paymentMethod             String?                 @db.VarChar(60)
  actorId                   String?                 @db.VarChar(36)
  actorName                 String?                 @db.VarChar(150)
  status                    LedgerTransactionStatus @default(CONFIRMED)
  reconciliationStatus      String                  @default("RECONCILED") @db.VarChar(60)
  reconciliationDiscrepancy String?                 @db.Text
  justification             String?                 @db.Text
  history                   Json?
  occurredAt                DateTime                @default(now())
  createdAt                 DateTime                @default(now())
  updatedAt                 DateTime                @updatedAt

  @@unique([tenantId, uniqueRef])
  @@index([tenantId, occurredAt])
  @@index([tenantId, type, status])
}

model CommissionRule {
  id             String   @id @default(uuid()) @db.VarChar(36)
  tenantId       String   @db.VarChar(36)
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  scope          String   @db.VarChar(60)
  professionalId String?  @db.VarChar(36)
  serviceId      String?  @db.VarChar(36)
  percentage     Int
  fixedCents     Int      @default(0)
  basis          String   @default("COMPLETED_SERVICE_VALUE") @db.VarChar(60)
  active         Boolean  @default(true)
  createdBy      String?  @db.VarChar(36)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([tenantId, active])
  @@index([tenantId, professionalId, serviceId])
}

enum CommissionStatus {
  NO_RULE_CONFIGURED
  PENDING_CALCULATION
  CALCULATED
  APPROVED
  PAID
  CANCELLED
}

model CommissionRecord {
  id                    String           @id @default(uuid()) @db.VarChar(36)
  tenantId              String           @db.VarChar(36)
  tenant                Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  appointmentId         String           @db.VarChar(36)
  professionalId        String           @db.VarChar(36)
  serviceId             String           @db.VarChar(36)
  ruleId                String?          @db.VarChar(36)
